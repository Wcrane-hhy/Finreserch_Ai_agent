# ============================================================
# FinResearch-Agent
# 原则：代码进仓库，生成物 / 个人数据 / 第三方版权内容不进仓库。
# 下面每一条都写了理由，不确定该不该加东西时先看一眼再改。
# ============================================================

# --- Python 编译产物 ---
__pycache__/
*.py[cod]
*$py.class

# --- 虚拟环境（各人自己建，不进仓库）---
.venv/
venv/
env/
ENV/
.conda/

# --- 测试与打包产物 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# --- 生成物：向量库 ---
# 约 10MB，而且完全可以从年报 PDF 重建：
#   python -m rag.rag_query --build
# 重建只要约 1 分钟，没有理由让它进版本库。
data/vector_db/

# --- 第三方版权内容：年报 PDF ---
# 约 7MB，是上市公司的公开披露文件，但不是本项目作者的版权，
# 不适合随仓库再分发。请自行从巨潮资讯网下载（见 data/reports/README.md）。
data/reports/*.pdf
!data/reports/README.md

# --- 运行产物：只保留一个示例，其余忽略 ---
# 每次 python main.py 都会生成一个时间戳目录，跑多了会淹没仓库。
# 保留的这一个用来展示输出格式长什么样。
runs/*
!runs/2026-09-28_221428/

# --- 本地工作区（含个人工作日志，不公开）---
# 这个目录是 AI 助手的项目记忆，属于个人笔记，不是项目代码。
.workbuddy/

# --- 第三方参考代码副本 ---
# docs/refs/ 是"项目二架构分析"的取证材料，里面的 vt/ vr/ 是从两个
# MIT 许可的开源仓库直接拷下来的源文件。为了不引入第三方代码的再分发
# 问题，这里只保留分析结论和自己的拉取脚本：fetch.py 可以一键重新拉下来。
# 详见 docs/refs/README.md。
docs/refs/vt/
docs/refs/vr/
docs/refs/*_tree.json

# --- IDE / 编辑器 ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 密钥兜底 ---
# 本项目设计上只从环境变量读 Key（代码里没有任何硬编码密钥），
# 这几条是防止以后手滑加了 .env 进来。
.env
.env.*
*.local
secrets.*

# --- 原始录制数据 ---
# 调试用的 SSE / 日志转储，体积大且是一次性的。
*.log
*.sse
